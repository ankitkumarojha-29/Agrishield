# ===================================================
# AgriShield Integration Backend — Environment Configuration
# ===================================================

# Database: Supabase / PostgreSQL with PostGIS extension (asyncpg driver)
# Note: AgriShield automatically normalizes postgres:// or postgresql:// to postgresql+asyncpg://
DATABASE_URL="postgresql+asyncpg://postgres.[REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT Authentication Secret Key (Generate a random 32+ character string)
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# AI Inference Service Endpoint (Laptop Tunnel or local dev)
AI_SERVICE_URL="http://localhost:8001"
AI_MODE="live"
MOCK_MODE="false"

# Copernicus Data Space Ecosystem (Sentinel-2 Satellite imagery & NDVI indices)
COPERNICUS_CLIENT_ID="your_copernicus_client_id"
COPERNICUS_CLIENT_SECRET="your_copernicus_client_secret"

# OpenWeatherMap API (Current weather & 7-day precipitation/temperature forecasts)
OPENWEATHER_API_KEY="your_openweather_api_key"

# Mandi Market Spot Rates (data.gov.in Agmarknet API key)
AGMARKNET_API_KEY="your_data_gov_in_agmarknet_api_key"

# Server Port (Defaults to 8000 locally, dynamically set by $PORT on Render)
PORT=8000
