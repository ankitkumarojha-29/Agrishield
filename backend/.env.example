# Database (PostgreSQL with PostGIS extension, e.g. Supabase, Neon, or local Docker)
DATABASE_URL="postgresql+asyncpg://postgres:<password>@<host>:5432/postgres"

# JWT Auth Secret
SECRET_KEY="replace-with-a-secure-random-secret-key"

# AI Inference Service connection
AI_SERVICE_URL="http://localhost:8001"
AI_MODE="live"
MOCK_MODE="false"

# Blockchain Integration (Polygon Amoy Testnet)
POLYGON_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"
POLYGON_PRIVATE_KEY="YOUR_WALLET_PRIVATE_KEY_HEX"
SMART_CONTRACT_ADDRESS="0x479c319C22928FF293713e70F24d399220d46876"
