# ===================================================
# AgriShield Web Portal — Environment Configuration
# ===================================================

# Integration API Base URL
# Local Development: http://localhost:8000/api/v1
# Cloud Production (Render): https://agrishield-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Mock/Demo Mode
# false = Connect to live FastAPI backend at VITE_API_BASE_URL (Default & Production)
# true  = Standalone UI preview using simulated client-side data
VITE_DEMO_MODE=false
