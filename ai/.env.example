# AI Inference Service Mode (false = live models/APIs, true = synthetic fallback data)
MOCK_MODE=false

# Copernicus Data Space Ecosystem (Sentinel-2 Satellite NDVI & Imagery)
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# OpenWeatherMap API (Current & Forecast Weather Analysis)
OPENWEATHER_API_KEY=your_openweather_api_key

# SoilHive Analytics (Soil Nitrogen, Phosphorus, Potassium, pH)
SOILHIVE_CLIENT_ID=your_soilhive_client_id
SOILHIVE_CLIENT_SECRET=your_soilhive_client_secret
SOILHIVE_API_TOKEN=your_soilhive_bearer_token
