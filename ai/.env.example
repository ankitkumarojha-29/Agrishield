# ===================================================
# AgriShield AI Inference Service — Environment Configuration
# ===================================================

# Service Port (Defaults to 8001)
PORT=8001

# Operational Mode
# false = live PyTorch, YOLOv8, Scikit-Learn models, OCR & real external APIs
# true  = synthetic fallback responses for ultra-fast local testing without GPUs/keys
MOCK_MODE=false

# Debug & Logging
DEBUG=false
LOG_LEVEL=INFO

# Confidence Threshold (predictions below this set low_confidence=true)
MIN_CONFIDENCE=0.7

# External API Integrations (Optional in MOCK_MODE, recommended for live pipelines)
# OpenWeatherMap API Key (Used for weather feature engineering in yield & risk scoring)
OPENWEATHER_API_KEY=your_openweather_api_key

# Copernicus Data Space Ecosystem (Sentinel-2 satellite NDVI, NDWI, NDMI imagery)
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# SoilHive API (Soil N, P, K, pH, and Organic Carbon extraction)
SOILHIVE_CLIENT_ID=your_soilhive_client_id
SOILHIVE_CLIENT_SECRET=your_soilhive_client_secret
SOILHIVE_API_TOKEN=your_soilhive_bearer_token

# Satellite Look-Back Window (days of Sentinel-2 imagery to analyze)
ANALYSIS_DAYS_BACK=45
